generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"`r`nurl      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ContactStatus {
  ACTIVE
  INACTIVE
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalStatus {
  DRAFT
  POSTED
  VOID
}

enum InvoiceStatus {
  DRAFT
  POSTED
  PARTIAL
  PAID
  VOID
}

enum PurchaseStatus {
  DRAFT
  POSTED
  PARTIAL
  PAID
  VOID
}

enum PaymentType {
  RECEIPT
  PAYMENT
}

enum PaymentMethod {
  CASH
  BANK
  CARD
  ONLINE
  OTHER
}

enum InventoryMovementType {
  PURCHASE
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
  OPENING
}

enum ReferenceType {
  PURCHASE
  SALE
  PURCHASE_RETURN
  SALE_RETURN
  ADJUSTMENT
  TRANSFER
  OPENING
}

enum FiscalPeriodStatus {
  OPEN
  CLOSED
}

// ============================================================
// COMPANY
// ============================================================

model Company {
  id        String   @id @default(cuid())
  name      String
  legalName String?
  ntn       String?
  email     String?
  phone     String?
  address   String?
  city      String?
  country   String   @default("Pakistan")
  currency  String   @default("PKR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  customers      Customer[]
  suppliers      Supplier[]
  categories     Category[]
  brands         Brand[]
  units          Unit[]
  products       Product[]
  warehouses     Warehouse[]
  accounts       Account[]
  journals       JournalEntry[]
  fiscalPeriods  FiscalPeriod[]
  salesInvoices  SalesInvoice[]
  purchaseBills  PurchaseBill[]
  payments       Payment[]
  inventoryMoves InventoryMovement[]
  batches        InventoryBatch[]

  @@index([name])
}

// ============================================================
// USERS & ROLES
// ============================================================

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model User {
  id        String     @id @default(cuid())
  companyId String
  roleId    String?
  name      String
  email     String     @unique
  password  String
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role    Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  createdJournals  JournalEntry[] @relation("JournalCreatedBy")
  postedJournals   JournalEntry[] @relation("JournalPostedBy")
  createdPayments  Payment[]      @relation("PaymentCreatedBy")
  createdInvoices  SalesInvoice[] @relation("SalesInvoiceCreatedBy")
  createdPurchases PurchaseBill[] @relation("PurchaseBillCreatedBy")

  @@index([companyId])
  @@index([roleId])
}

// ============================================================
// CUSTOMERS
// ============================================================

model Customer {
  id             String        @id @default(cuid())
  companyId      String
  name           String
  email          String?
  phone          String?
  address        String?
  city           String?
  taxNumber      String?
  openingBalance Decimal       @default(0) @db.Decimal(18, 2)
  creditLimit    Decimal       @default(0) @db.Decimal(18, 2)
  status         ContactStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesInvoices SalesInvoice[]
  payments      Payment[]

  @@index([companyId])
  @@index([name])
}

// ============================================================
// SUPPLIERS
// ============================================================

model Supplier {
  id             String        @id @default(cuid())
  companyId      String
  name           String
  email          String?
  phone          String?
  address        String?
  city           String?
  taxNumber      String?
  openingBalance Decimal       @default(0) @db.Decimal(18, 2)
  creditLimit    Decimal       @default(0) @db.Decimal(18, 2)
  status         ContactStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseBills PurchaseBill[]
  payments      Payment[]
  batches       InventoryBatch[]

  @@index([companyId])
  @@index([name])
}

// ============================================================
// PRODUCT CATEGORIES
// ============================================================

model Category {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
}

// ============================================================
// BRANDS
// ============================================================

model Brand {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
}

// ============================================================
// UNITS
// ============================================================

model Unit {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  abbreviation String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
}

// ============================================================
// PRODUCTS
// ============================================================

model Product {
  id          String      @id @default(cuid())
  companyId   String
  categoryId  String?
  brandId     String?
  unitId      String?
  sku         String
  name        String
  description String?
  type        ProductType @default(PRODUCT)

  /**
   * These remain as product-level defaults.
   * Actual inventory valuation is NOT based on costPrice.
   * Actual COGS comes from the selected InventoryBatch.
   */
  costPrice    Decimal @default(0) @db.Decimal(18, 2)
  salePrice    Decimal @default(0) @db.Decimal(18, 2)
  reorderLevel Decimal @default(0) @db.Decimal(18, 3)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand    Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unit     Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)

  stock          Stock[]
  stockBatches   StockBatch[]
  inventoryMoves InventoryMovement[]
  batches        InventoryBatch[]
  salesLines     SalesInvoiceLine[]
  purchaseLines  PurchaseBillLine[]

  inventoryAccountId String?
  salesAccountId     String?
  cogsAccountId      String?
  purchaseAccountId  String?

  inventoryAccount Account? @relation("ProductInventoryAccount", fields: [inventoryAccountId], references: [id], onDelete: SetNull)
  salesAccount     Account? @relation("ProductSalesAccount", fields: [salesAccountId], references: [id], onDelete: SetNull)
  cogsAccount      Account? @relation("ProductCOGSAccount", fields: [cogsAccountId], references: [id], onDelete: SetNull)
  purchaseAccount  Account? @relation("ProductPurchaseAccount", fields: [purchaseAccountId], references: [id], onDelete: SetNull)

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([categoryId])
  @@index([brandId])
  @@index([unitId])
}

// ============================================================
// WAREHOUSES
// ============================================================

model Warehouse {
  id        String   @id @default(cuid())
  companyId String
  name      String
  code      String
  address   String?
  city      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  stock        Stock[]
  stockBatches StockBatch[]

  inventoryMovesFrom InventoryMovement[] @relation("MovementSourceWarehouse")
  inventoryMovesTo   InventoryMovement[] @relation("MovementDestinationWarehouse")
  salesInvoiceLines  SalesInvoiceLine[]
  purchaseBillLines  PurchaseBillLine[]

  @@unique([companyId, code])
  @@index([companyId])
}

// ============================================================
// TOTAL PRODUCT STOCK BY WAREHOUSE
// ============================================================

model Stock {
  id          String @id @default(cuid())
  productId   String
  warehouseId String

  quantity    Decimal @default(0) @db.Decimal(18, 3)
  averageCost Decimal @default(0) @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
}

// ============================================================
// INVENTORY BATCH
//
// One batch represents one cost layer.
//
// Example:
//
// Product: Watch ABC
// Batch: WB-001
// Cost: PKR 1,000
// Purchased: 20
//
// Product: Watch ABC
// Batch: WB-002
// Cost: PKR 1,200
// Purchased: 15
//
// These remain separate cost layers.
// ============================================================

model InventoryBatch {
  id        String @id @default(cuid())
  companyId String
  productId String

  /**
   * Human-readable batch identifier.
   * Example:
   * WB-2026-001
   */
  batchNumber String

  purchaseBillId String?
  supplierId     String?

  purchaseDate DateTime @default(now())

  /**
   * Cost per unit for this batch.
   * This is the cost used for COGS.
   */
  unitCost Decimal @db.Decimal(18, 2)

  /**
   * Quantity originally received into this batch.
   */
  originalQuantity Decimal @db.Decimal(18, 3)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplier     Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseBill PurchaseBill? @relation(fields: [purchaseBillId], references: [id], onDelete: SetNull)

  stockBatches StockBatch[]

  purchaseLines PurchaseBillLine[]
  salesLines    SalesInvoiceLine[]

  inventoryMoves InventoryMovement[]

  @@unique([companyId, productId, batchNumber])
  @@index([companyId])
  @@index([productId])
  @@index([supplierId])
  @@index([purchaseBillId])
  @@index([batchNumber])
}

// ============================================================
// BATCH STOCK BY WAREHOUSE
//
// This is extremely important.
//
// A single batch can move between warehouses.
//
// Example:
//
// Batch WB-001
//
// Main Warehouse = 8
// Home Store      = 2
//
// Total batch quantity = 10
// ============================================================

model StockBatch {
  id          String @id @default(cuid())
  batchId     String
  productId   String
  warehouseId String

  quantity Decimal @default(0) @db.Decimal(18, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch     InventoryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([batchId, warehouseId])
  @@index([batchId])
  @@index([productId])
  @@index([warehouseId])
}

// ============================================================
// INVENTORY MOVEMENTS
//
// Every movement records the actual batch and cost.
//
// This is what allows historical COGS reconstruction.
// ============================================================

model InventoryMovement {
  id        String  @id @default(cuid())
  companyId String
  productId String
  batchId   String?

  sourceWarehouseId      String?
  destinationWarehouseId String?

  type          InventoryMovementType
  referenceType ReferenceType?
  referenceId   String?

  quantity  Decimal @db.Decimal(18, 3)
  unitCost  Decimal @default(0) @db.Decimal(18, 2)
  totalCost Decimal @default(0) @db.Decimal(18, 2)

  movementDate DateTime @default(now())
  notes        String?

  createdAt DateTime @default(now())

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch   InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  sourceWarehouse Warehouse? @relation("MovementSourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: SetNull)

  destinationWarehouse Warehouse? @relation("MovementDestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([productId])
  @@index([batchId])
  @@index([movementDate])
  @@index([referenceId])
}

// ============================================================
// CHART OF ACCOUNTS
// ============================================================

model Account {
  id          String      @id @default(cuid())
  companyId   String
  parentId    String?
  code        String
  name        String
  type        AccountType
  description String?
  isActive    Boolean     @default(true)

  systemCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  parent   Account?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Account[] @relation("AccountHierarchy")

  journalLines JournalLine[]

  inventoryProducts Product[] @relation("ProductInventoryAccount")
  salesProducts     Product[] @relation("ProductSalesAccount")
  cogsProducts      Product[] @relation("ProductCOGSAccount")
  purchaseProducts  Product[] @relation("ProductPurchaseAccount")

  paymentAccounts Payment[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([parentId])
}

// ============================================================
// FISCAL PERIODS
// ============================================================

model FiscalPeriod {
  id        String             @id @default(cuid())
  companyId String
  name      String
  startDate DateTime
  endDate   DateTime
  status    FiscalPeriodStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
  @@index([startDate, endDate])
}

// ============================================================
// JOURNAL ENTRIES
// ============================================================

model JournalEntry {
  id          String        @id @default(cuid())
  companyId   String
  entryNumber String
  entryDate   DateTime      @default(now())
  reference   String?
  description String?
  status      JournalStatus @default(DRAFT)

  createdById String?
  postedById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdBy User? @relation("JournalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  postedBy  User? @relation("JournalPostedBy", fields: [postedById], references: [id], onDelete: SetNull)

  lines JournalLine[]

  salesInvoice SalesInvoice?
  purchaseBill PurchaseBill?
  payment      Payment?

  @@unique([companyId, entryNumber])
  @@index([companyId])
  @@index([entryDate])
}

// ============================================================
// JOURNAL LINES
// ============================================================

model JournalLine {
  id             String @id @default(cuid())
  journalEntryId String
  accountId      String

  description String?

  debit  Decimal @default(0) @db.Decimal(18, 2)
  credit Decimal @default(0) @db.Decimal(18, 2)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
}

// ============================================================
// SALES INVOICES
// ============================================================

model SalesInvoice {
  id          String    @id @default(cuid())
  companyId   String
  customerId  String
  invoiceNo   String
  invoiceDate DateTime  @default(now())
  dueDate     DateTime?

  status InvoiceStatus @default(DRAFT)

  subtotal Decimal @default(0) @db.Decimal(18, 2)
  discount Decimal @default(0) @db.Decimal(18, 2)
  tax      Decimal @default(0) @db.Decimal(18, 2)
  total    Decimal @default(0) @db.Decimal(18, 2)
  paid     Decimal @default(0) @db.Decimal(18, 2)
  balance  Decimal @default(0) @db.Decimal(18, 2)

  /**
   * Total COGS of this invoice.
   * This is calculated from the batches selected
   * on the invoice lines.
   */
  cogs Decimal @default(0) @db.Decimal(18, 2)

  notes String?

  createdById String?
  journalId   String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  createdBy User? @relation("SalesInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  journal JournalEntry? @relation(fields: [journalId], references: [id], onDelete: SetNull)

  lines       SalesInvoiceLine[]
  allocations SalesPaymentAllocation[]

  @@unique([companyId, invoiceNo])
  @@index([companyId])
  @@index([customerId])
  @@index([invoiceDate])
  @@index([status])
}

// ============================================================
// SALES INVOICE LINES
//
// IMPORTANT:
//
// The user selects the batch here.
//
// The same product may appear multiple times on one invoice
// if different batches are selected.
//
// Example:
//
// Watch ABC | Batch A | Qty 2 | Cost 1,000 | Sale 1,500
// Watch ABC | Batch B | Qty 3 | Cost 1,200 | Sale 1,600
// ============================================================

model SalesInvoiceLine {
  id        String @id @default(cuid())
  invoiceId String
  productId String
  batchId   String

  description String?

  quantity  Decimal @db.Decimal(18, 3)
  unitPrice Decimal @db.Decimal(18, 2)

  discount Decimal @default(0) @db.Decimal(18, 2)
  tax      Decimal @default(0) @db.Decimal(18, 2)
  total    Decimal @default(0) @db.Decimal(18, 2)

  warehouseId String

  /**
   * Snapshot of the batch cost at the time of sale.
   * We keep this even though InventoryBatch.unitCost exists.
   * This protects historical accounting if a batch is ever
   * corrected or adjusted later.
   */
  cogsUnitCost Decimal @default(0) @db.Decimal(18, 2)
  cogsTotal    Decimal @default(0) @db.Decimal(18, 2)

  invoice   SalesInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch     InventoryBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([productId])
  @@index([batchId])
  @@index([warehouseId])
}

// ============================================================
// PURCHASE BILLS
// ============================================================

model PurchaseBill {
  id         String    @id @default(cuid())
  companyId  String
  supplierId String
  billNo     String
  billDate   DateTime  @default(now())
  dueDate    DateTime?

  status PurchaseStatus @default(DRAFT)

  subtotal Decimal @default(0) @db.Decimal(18, 2)
  discount Decimal @default(0) @db.Decimal(18, 2)
  tax      Decimal @default(0) @db.Decimal(18, 2)
  total    Decimal @default(0) @db.Decimal(18, 2)
  paid     Decimal @default(0) @db.Decimal(18, 2)
  balance  Decimal @default(0) @db.Decimal(18, 2)

  notes String?

  createdById String?
  journalId   String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  createdBy User? @relation("PurchaseBillCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  journal JournalEntry? @relation(fields: [journalId], references: [id], onDelete: SetNull)

  lines       PurchaseBillLine[]
  allocations PurchasePaymentAllocation[]
  batches     InventoryBatch[]

  @@unique([companyId, billNo])
  @@index([companyId])
  @@index([supplierId])
  @@index([billDate])
  @@index([status])
}

// ============================================================
// PURCHASE BILL LINES
//
// Each purchase line creates/links to a specific batch.
//
// Example:
//
// Product: Watch ABC
// Qty: 20
// Unit cost: 1,000
// Batch: WB-001
//
// Later:
//
// Product: Watch ABC
// Qty: 15
// Unit cost: 1,200
// Batch: WB-002
// ============================================================

model PurchaseBillLine {
  id        String @id @default(cuid())
  billId    String
  productId String
  batchId   String

  description String?

  quantity Decimal @db.Decimal(18, 3)
  unitCost Decimal @db.Decimal(18, 2)

  discount Decimal @default(0) @db.Decimal(18, 2)
  tax      Decimal @default(0) @db.Decimal(18, 2)
  total    Decimal @default(0) @db.Decimal(18, 2)

  warehouseId String

  bill      PurchaseBill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch     InventoryBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([billId])
  @@index([productId])
  @@index([batchId])
  @@index([warehouseId])
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id         String  @id @default(cuid())
  companyId  String
  customerId String?
  supplierId String?
  accountId  String

  paymentNo   String
  paymentDate DateTime @default(now())

  type   PaymentType
  method PaymentMethod @default(CASH)

  amount      Decimal @db.Decimal(18, 2)
  reference   String?
  description String?

  journalId   String? @unique
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  journal   JournalEntry? @relation(fields: [journalId], references: [id], onDelete: SetNull)
  createdBy User?         @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  salesAllocations    SalesPaymentAllocation[]
  purchaseAllocations PurchasePaymentAllocation[]

  @@unique([companyId, paymentNo])
  @@index([companyId])
  @@index([customerId])
  @@index([supplierId])
  @@index([accountId])
  @@index([paymentDate])
}

// ============================================================
// SALES PAYMENT ALLOCATION
// ============================================================

model SalesPaymentAllocation {
  id        String @id @default(cuid())
  paymentId String
  invoiceId String

  amount Decimal @db.Decimal(18, 2)

  payment Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([paymentId, invoiceId])
  @@index([paymentId])
  @@index([invoiceId])
}

// ============================================================
// PURCHASE PAYMENT ALLOCATION
// ============================================================

model PurchasePaymentAllocation {
  id        String @id @default(cuid())
  paymentId String
  billId    String

  amount Decimal @db.Decimal(18, 2)

  payment Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill    PurchaseBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([paymentId, billId])
  @@index([paymentId])
  @@index([billId])
}

