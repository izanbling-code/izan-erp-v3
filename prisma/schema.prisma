generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PeriodStatus {
  OPEN
  LOCKED
  CLOSED
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceStatus {
  DRAFT
  POSTED
  PARTIAL
  PAID
  VOID
}

enum PurchaseStatus {
  DRAFT
  POSTED
  PARTIAL
  PAID
  VOID
}

enum PaymentType {
  RECEIPT
  PAYMENT
}

enum JournalStatus {
  DRAFT
  POSTED
  VOID
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum ProductType {
  PRODUCT
  GOODS
  SERVICE
}

enum MovementType {
  OPENING
  PURCHASE
  SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

model Company {
  id        String   @id @default(cuid())
  name      String   @default("Izan Bling")
  legalName String?
  ntn       String?
  email     String?
  phone     String?
  address   String?
  city      String?
  country   String   @default("Pakistan")
  currency  String   @default("PKR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  roles            Role[]
  accounts         Account[]
  categories       Category[]
  brands           Brand[]
  units            Unit[]
  products         Product[]
  warehouses       Warehouse[]
  customers        Customer[]
  suppliers        Supplier[]
  salesInvoices    SalesInvoice[]
  purchaseBills    PurchaseBill[]
  journalEntries   JournalEntry[]
  payments         Payment[]
  fiscalPeriods    FiscalPeriod[]
  inventoryMoves   InventoryMovement[]
  inventoryBatches InventoryBatch[]
  companySettings  CompanySettings?

  expenseVouchers  ExpenseVoucher[]
  supplierPayments SupplierPayment[]
  loans            Loan[]
  orders           Order[]
  orderLines       OrderLine[]
}

model Role {
  id          String   @id @default(cuid())
  companyId   String
  name        String   // e.g., "Cashier", "Admin"
  
  // Stores exact allowed route paths: ["/dashboard", "/sales/invoices"]
  permissions String[] 
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@unique([companyId, name])
  @@index([companyId])
}

model User {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  email       String   @unique
  password    String   // Hashed password
  isActive    Boolean  @default(true)

  roleId      String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  role        Role     @relation(fields: [roleId], references: [id])
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions        Session[]
  
  @@index([companyId])
  @@index([roleId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id          String      @id @default(cuid())
  companyId   String
  parentId    String?
  code        String
  name        String
  type        AccountType
  description String?
  systemCode  String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent            Account?      @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children          Account[]     @relation("AccountHierarchy")
  lines             JournalLine[]
  journalLines      JournalLine[] @relation("AccountJournalLines")
  payments          Payment[]
  inventoryProducts Product[]     @relation("InventoryAccount")
  salesProducts     Product[]     @relation("SalesAccount")
  cogsProducts      Product[]     @relation("CogsAccount")
  purchaseProducts  Product[]     @relation("PurchaseAccount")

  @@unique([companyId, code])
  @@index([companyId])
}

model JournalEntry {
  id            String        @id @default(cuid())
  companyId     String
  entryNo       String        @default("AUTO-ENTRY")
  entryNumber   String?
  entryDate     DateTime
  description   String?
  status        JournalStatus @default(POSTED)
  reference     String?
  referenceType String?
  referenceId   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines         JournalLine[]
  salesInvoices SalesInvoice[]
  purchaseBills PurchaseBill[]

  @@index([companyId])
}

model JournalLine {
  id             String   @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Decimal  @default(0)
  credit         Decimal  @default(0)
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade, map: "JournalLine_journalEntryId_fkey")
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict, map: "JournalLine_accountId_fkey")
  accountLines Account      @relation("AccountJournalLines", fields: [accountId], references: [id], onDelete: Restrict, map: "JournalLine_accountLines_fkey")

  @@index([journalEntryId])
  @@index([accountId])
}

model Category {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
}

model Brand {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
}

model Unit {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  abbreviation String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
}

model Product {
  id                 String      @id @default(cuid())
  companyId          String
  categoryId         String?
  brandId            String?
  unitId             String?
  name               String
  sku                String
  description        String?
  imageUrl           String?
  type               ProductType @default(GOODS)
  costPrice          Decimal     @default(0)
  salePrice          Decimal     @default(0)
  salesPrice         Decimal     @default(0)
  reorderLevel       Decimal     @default(0)
  inventoryAccountId String?
  salesAccountId     String?
  cogsAccountId      String?
  purchaseAccountId  String?
  isActive           Boolean     @default(true)
  useDefaultAccounts Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  company          Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category         Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand            Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unit             Unit?               @relation(fields: [unitId], references: [id], onDelete: SetNull)
  inventoryAccount Account?            @relation("InventoryAccount", fields: [inventoryAccountId], references: [id], onDelete: SetNull)
  salesAccount     Account?            @relation("SalesAccount", fields: [salesAccountId], references: [id], onDelete: SetNull)
  cogsAccount      Account?            @relation("CogsAccount", fields: [cogsAccountId], references: [id], onDelete: SetNull)
  purchaseAccount  Account?            @relation("PurchaseAccount", fields: [purchaseAccountId], references: [id], onDelete: SetNull)
  salesLines       SalesInvoiceLine[]
  purchaseLines    PurchaseBillLine[]
  stocks           Stock[]
  stock            Stock[]             @relation("ProductStock")
  batches          InventoryBatch[]
  stockBatches     StockBatch[]
  inventoryMoves   InventoryMovement[]
  orderLines       OrderLine[]

  @@unique([companyId, sku])
  @@index([companyId])
}

model Warehouse {
  id        String   @id @default(cuid())
  companyId String
  name      String
  code      String
  address   String?
  city      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stocks             Stock[]
  stockBatches       StockBatch[]
  inventoryMovesFrom InventoryMovement[] @relation("SourceWarehouse")
  inventoryMovesTo   InventoryMovement[] @relation("DestWarehouse")
  salesLines         SalesInvoiceLine[]
  purchaseLines      PurchaseBillLine[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Stock {
  id          String   @id @default(cuid())
  productId   String
  warehouseId String
  quantity    Decimal  @default(0)
  averageCost Decimal  @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade, map: "Stock_productId_fkey")
  productStock Product   @relation("ProductStock", fields: [productId], references: [id], onDelete: Cascade, map: "Stock_productStock_fkey")
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade, map: "Stock_warehouseId_fkey")

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
}

model InventoryBatch {
  id               String   @id @default(cuid())
  companyId        String
  productId        String
  purchaseBillId   String?
  supplierId       String?
  batchNumber      String
  purchaseDate     DateTime
  unitCost         Decimal
  originalQuantity Decimal
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseBill   PurchaseBill?       @relation(fields: [purchaseBillId], references: [id], onDelete: SetNull)
  supplier       Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stockBatches   StockBatch[]
  inventoryMoves InventoryMovement[]
  salesLines     SalesInvoiceLine[]
  purchaseLines  PurchaseBillLine[]

  @@index([productId])
  @@index([companyId])
}

model StockBatch {
  id          String   @id @default(cuid())
  batchId     String
  productId   String
  warehouseId String
  quantity    Decimal  @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batch     InventoryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([batchId, warehouseId])
  @@index([batchId])
  @@index([productId])
  @@index([warehouseId])
}

model InventoryMovement {
  id                     String       @id @default(cuid())
  companyId              String
  productId              String
  batchId                String
  sourceWarehouseId      String?
  destinationWarehouseId String?
  type                   MovementType
  referenceType          String       @default("MANUAL")
  referenceId            String?
  quantity               Decimal
  unitCost               Decimal
  totalCost              Decimal
  movementDate           DateTime     @default(now())
  notes                  String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @default(now()) @updatedAt

  company              Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product              Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch                InventoryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sourceWarehouse      Warehouse?     @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: SetNull)
  destinationWarehouse Warehouse?     @relation("DestWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([productId])
  @@index([batchId])
}

model Customer {
  id             String     @id @default(cuid())
  companyId      String
  name           String
  email          String?
  phone          String?
  address        String?
  city           String?
  taxNumber      String?
  openingBalance Decimal    @default(0)
  creditLimit    Decimal    @default(0)
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesInvoices SalesInvoice[]
  payments      Payment[]

    orders        Order[]
  whatsapp      String?

  @@index([companyId])
}

model Supplier {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  email          String?
  phone          String?
  address        String?
  city           String?
  taxNumber      String?
  openingBalance Decimal  @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseBills    PurchaseBill[]
  inventoryBatches InventoryBatch[]
  payments         Payment[]

  @@index([companyId])
}

model SalesInvoice {
  id              String        @id @default(cuid())
  companyId       String
  customerId      String
  invoiceNo       String
  invoiceDate     DateTime
  dueDate         DateTime?
  status          InvoiceStatus @default(DRAFT)
  subtotal        Decimal       @default(0)
  discount        Decimal       @default(0)
  tax             Decimal       @default(0)
  deliveryCharges Decimal       @default(0)
  total           Decimal       @default(0)
  paid            Decimal       @default(0)
  balance         Decimal       @default(0)
  cogs            Decimal       @default(0)
  notes           String?
  journalId       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company     Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  journal     JournalEntry?            @relation(fields: [journalId], references: [id], onDelete: SetNull)
  lines       SalesInvoiceLine[]
  allocations SalesPaymentAllocation[]

  @@unique([companyId, invoiceNo])
  @@index([companyId])
}

model SalesInvoiceLine {
  id              String   @id @default(cuid())
  invoiceId       String
  productId       String
  batchId         String?
  warehouseId     String?
  description     String?
  quantity        Decimal
  unitPrice       Decimal
  discount        Decimal  @default(0)
  tax             Decimal  @default(0)
  deliveryCharges Decimal  @default(0)
  total           Decimal
  cogsUnitCost    Decimal  @default(0)
  cogsTotal       Decimal  @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  invoice   SalesInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch     InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  warehouse Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
}

model PurchaseBill {
  id              String         @id @default(cuid())
  companyId       String
  supplierId      String
  billNo          String
  billDate        DateTime
  dueDate         DateTime?
  status          PurchaseStatus @default(DRAFT)
  subtotal        Decimal        @default(0)
  discount        Decimal        @default(0)
  tax             Decimal        @default(0)
  deliveryCharges Decimal        @default(0)
  total           Decimal        @default(0)
  paid            Decimal        @default(0)
  balance         Decimal        @default(0)
  notes           String?
  journalId       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  company     Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier    Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  journal     JournalEntry?               @relation(fields: [journalId], references: [id], onDelete: SetNull)
  lines       PurchaseBillLine[]
  allocations PurchasePaymentAllocation[]
  batches     InventoryBatch[]

  @@unique([companyId, billNo])
  @@index([companyId])
}

model PurchaseBillLine {
  id              String   @id @default(cuid())
  billId          String
  productId       String
  batchId         String?
  warehouseId     String?
  description     String?
  quantity        Decimal
  unitCost        Decimal
  discount        Decimal  @default(0)
  tax             Decimal  @default(0)
  deliveryCharges Decimal  @default(0)
  total           Decimal
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  bill      PurchaseBill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch     InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  warehouse Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([billId])
  @@index([productId])
}

model Payment {
  id               String      @id @default(cuid())
  companyId        String
  customerId       String?
  supplierId       String?
  accountId        String?
  expenseAccountId String?
  paymentNo        String
  paymentDate      DateTime
  type             PaymentType
  method           String      @default("CASH")
  amount           Decimal     @default(0)
  reference        String?
  description      String?
  journalId        String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  company             Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer            Customer?                   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier            Supplier?                   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  account             Account?                    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  salesAllocations    SalesPaymentAllocation[]
  purchaseAllocations PurchasePaymentAllocation[]

  @@unique([companyId, paymentNo])
  @@index([companyId])
}

model SalesPaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  invoiceId String
  amount    Decimal  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  payment Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([invoiceId])
}

model PurchasePaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  billId    String
  amount    Decimal  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  payment Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill    PurchaseBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([billId])
}

model FiscalPeriod {
  id        String       @id @default(cuid())
  companyId String
  name      String
  startDate DateTime
  endDate   DateTime
  status    PeriodStatus @default(OPEN)
  closedAt  DateTime?
  closedBy  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}

model CompanySettings {
  id            String   @id @default(cuid())
  companyId     String   @unique
  security      Json?
  accounting    Json?
  general       Json?
  sales         Json?
  purchases     Json?
  inventory     Json?
  tax           Json?
  numbering     Json?
  notifications Json?
  appearance    Json?
  dashboard     Json?
  modules       Json?
  templates     Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  module      String?
  action      String?
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// ==========================================
// ÃƒÂ°Ã…Â¸Ã‚ÂÃ¢â‚¬ÂºÃƒÂ¯Ã‚Â¸Ã‚Â BANKING SUBLEDGER MODULE
// ==========================================

model BankAccount {
  id          String @id @default(cuid())
  companyId   String // Soft-link to Company
  glAccountId String @unique // Soft-link to General Ledger Account

  bankName      String
  accountTitle  String
  accountNumber String
  iban          String?
  branchCode    String?
  swiftCode     String?
  currency      String  @default("PKR")

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BankTransaction {
  id            String  @id @default(cuid())
  companyId     String // Soft-link to Company
  bankAccountId String // Soft-link to BankAccount
  journalLineId String? @unique // Optional soft-link to GL Journal Line

  transactionDate DateTime
  clearanceDate   DateTime? // For future Cheque/Reconciliation clearing

  reference   String?
  description String

  // Future-proofing for Cheques
  instrumentType String  @default("ONLINE_TRANSFER") // CASH, CHEQUE, ONLINE_TRANSFER
  instrumentNo   String? // Cheque number or Transfer ID

  moneyIn  Decimal @default(0) @db.Decimal(15, 2)
  moneyOut Decimal @default(0) @db.Decimal(15, 2)

  // Status lifecycle
  status String @default("CLEARED") // PENDING, CLEARED, BOUNCED, RECONCILED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// ðŸŽª POP-UP EVENT SANDBOX MODULE
// ==========================================

model EventPlanner {
  id        String   @id @default(cuid())
  companyId String
  name      String
  eventDate DateTime
  location  String?
  notes     String?
  status    String   @default("DRAFT") // DRAFT, POSTED

  items    EventItem[]
  expenses EventExpense[]
  sales    EventSale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventItem {
  id             String   @id @default(cuid())
  eventId        String
  name           String
  quantity       Int      @default(0)
  unitCost       Decimal  @default(0) @db.Decimal(15, 2)
  suggestedPrice Decimal? @db.Decimal(15, 2)
  finalSalePrice Decimal? @db.Decimal(15, 2)

  event     EventPlanner    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  saleItems EventSaleItem[]
}

model EventExpense {
  id          String  @id @default(cuid())
  eventId     String
  description String
  amount      Decimal @default(0) @db.Decimal(15, 2)

  event EventPlanner @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EventSale {
  id            String   @id @default(cuid())
  eventId       String
  customerName  String?
  customerPhone String?
  totalAmount   Decimal  @default(0) @db.Decimal(15, 2)
  paymentMethod String   @default("CASH")
  createdAt     DateTime @default(now())

  event EventPlanner    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items EventSaleItem[]
}

model EventSaleItem {
  id         String  @id @default(cuid())
  saleId     String
  itemId     String
  quantity   Int     @default(1)
  unitPrice  Decimal @db.Decimal(15, 2)
  totalPrice Decimal @db.Decimal(15, 2)

  sale EventSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item EventItem @relation(fields: [itemId], references: [id])
}

// ==========================================
// PAYABLES, EXPENSES & LOAN MODULES
// ==========================================

enum ApprovalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  POSTED
  VOID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  CREDIT
}

enum ExpenseType {
  DIRECT_PAYMENT
  ACCRUED_LIABILITY
  PREPAID_EXPENSE
}

model ExpenseVoucher {
  id               String         @id @default(cuid())
  companyId        String
  voucherNumber    String
  date             DateTime
  amount           Decimal
  expenseType      ExpenseType    @default(DIRECT_PAYMENT)
  accountId        String // The target Expense GL account ID
  paymentMethod    PaymentMethod?
  paymentAccountId String? // Where the money came from (Bank/Cash)
  status           ApprovalStatus @default(DRAFT)
  referenceNo      String?
  notes            String?
  journalId        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model SupplierPayment {
  id            String         @id @default(cuid())
  companyId     String
  paymentNumber String
  supplierId    String? // ID of the Supplier being paid
  date          DateTime
  amount        Decimal
  method        PaymentMethod
  accountId     String // Bank or Cash GL Account ID
  status        ApprovalStatus @default(DRAFT)
  referenceNo   String?
  isAdvance     Boolean        @default(false)
  notes         String?
  journalId     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]
}

model PaymentAllocation {
  id                String  @id @default(cuid())
  supplierPaymentId String
  referenceBillId   String // ID of the PurchaseBill being paid off
  amount            Decimal

  payment SupplierPayment @relation(fields: [supplierPaymentId], references: [id], onDelete: Cascade)
}

enum LoanType {
  GIVEN // Company gave money (Asset)
  TAKEN // Company received money (Liability)
}

model Loan {
  id          String         @id @default(cuid())
  companyId   String
  loanNumber  String
  type        LoanType
  partyName   String // Entity/Person who gave or received the loan
  principal   Decimal
  balance     Decimal
  issueDate   DateTime
  status      ApprovalStatus @default(DRAFT)
  referenceNo String?
  accountId   String // Bank/Cash account where funds were received/sent
  notes       String?
  journalId   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  repayments LoanRepayment[]
}

model LoanRepayment {
  id          String         @id @default(cuid())
  loanId      String
  date        DateTime
  amount      Decimal
  method      PaymentMethod
  accountId   String // Bank/Cash account used for the repayment
  status      ApprovalStatus @default(DRAFT)
  referenceNo String?
  notes       String?
  journalId   String?
  createdAt   DateTime       @default(now())

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model SequenceCounter {
  id       String @id @default(cuid())
  tenantId String
  model    String
  prefix   String
  nextVal  Int    @default(1)

  @@unique([tenantId, model])
  @@index([tenantId])
}


// --- E-COMMERCE & WHATSAPP MODELS ---

enum OrderStatus {
  SALE_ORDER
  CONFIRMATION
  PACKING
  BOOKED
  DISPATCHED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

model Order {
  id              String        @id @default(cuid())
  companyId       String
  orderNumber     String
  customerId      String
  paymentSlipUrl  String?
  
  status          OrderStatus   @default(SALE_ORDER)
  paymentStatus   PaymentStatus @default(PENDING)
  totalAmount     Decimal       @db.Decimal(12, 2)
  
  // New Logistics Fields
  bookingNumber   String?
  deliveryCharges Decimal       @default(0) @db.Decimal(12, 2)
  whatsappRef     String?
  
  version         Int           @default(1)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer        Customer      @relation(fields: [customerId], references: [id])
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines           OrderLine[]

  @@index([companyId, status])
  @@unique([companyId, orderNumber])
}
model OrderLine {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  companyId   String   
  
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  subtotal    Decimal  @db.Decimal(12, 2)

  // Relations
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([orderId])
}
