                      setEditTax(
                        Number(
                          e.target.value
                        ) || 0
                      )
                    }
                    style={{
                      padding:
                        "9px 11px",
                      border:
                        "1px solid #d8dee8",
                      borderRadius:
                        "8px",
                    }}
                  />
                </label>

                <div
                  style={{
                    padding:
                      "11px 13px",
                    border:
                      "1px solid #e4e8ef",
                    borderRadius:
                      "9px",
                    background:
                      "#fbfcfe",
                  }}
                >
                  <div
                    style={{
                      color:
                        "#667085",
                      fontSize:
                        "11px",
                      fontWeight:
                        700,
                      textTransform:
                        "uppercase",
                    }}
                  >
                    Calculated Subtotal
                  </div>

                  <div
                    style={{
                      marginTop:
                        "4px",
                      color:
                        "#172033",
                      fontWeight:
                        800,
                      fontSize:
                        "16px",
                    }}
                  >
                    {money(
                      editSubtotal()
                    )}
                  </div>
                </div>

                <div
                  style={{
                    padding:
                      "11px 13px",
                    border:
                      "1px solid #e4e8ef",
                    borderRadius:
                      "9px",
                    background:
                      "#fbfcfe",
                  }}
                >
                  <div
                    style={{
                      color:
                        "#667085",
                      fontSize:
                        "11px",
                      fontWeight:
                        700,
                      textTransform:
                        "uppercase",
                    }}
                  >
                    Calculated Total
                  </div>

                  <div
                    style={{
                      marginTop:
                        "4px",
                      color:
                        "#172033",
                      fontWeight:
                        800,
                      fontSize:
                        "16px",
                    }}
                  >
                    {money(
                      editTotal()
                    )}
                  </div>
                </div>
              </div>

              <label
                style={{
                  display:
                    "flex",
                  flexDirection:
                    "column",
                  gap: "6px",
                  marginTop:
                    "16px",
                }}
              >
                <span
                  style={{
                    color:
                      "#475467",
                    fontSize:
                      "12px",
                    fontWeight:
                      700,
                  }}
                >
                  Notes
                </span>

                <textarea
                  value={
                    editNotes
                  }
                  onChange={(e) =>
                    setEditNotes(
                      e.target.value
                    )
                  }
                  rows={3}
                  style={{
                    resize:
                      "vertical",
                    padding:
                      "9px 11px",
                    border:
                      "1px solid #d8dee8",
                    borderRadius:
                      "8px",
                    fontSize:
                      "13px",
                  }}
                />
              </label>
            </div>

            <div
              style={{
                padding:
                  "16px 24px",
                borderTop:
                  "1px solid #edf0f5",
                display:
                  "flex",
                justifyContent:
                  "flex-end",
                gap: "9px",
                flexWrap:
                  "wrap",
              }}
            >
              <button
                type="button"
                disabled={
                  saving ||
                  posting
                }
                onClick={() => {
                  setEditInvoice(
                    null
                  );
                  setModalError("");
                }}
                style={{
                  border:
                    "1px solid #d0d5dd",
                  background:
                    "#ffffff",
                  color:
                    "#344054",
                  padding:
                    "9px 15px",
                  borderRadius:
                    "8px",
                  fontWeight:
                    700,
                  cursor:
                    "pointer",
                }}
              >
                Cancel
              </button>

              <button
                type="button"
                disabled={
                  saving ||
                  posting
                }
                onClick={() =>
                  saveInvoice(
                    false
                  )
                }
                style={{
                  border:
                    "1px solid #7b61a8",
                  background:
                    "#ffffff",
                  color:
                    "#684f8d",
                  padding:
                    "9px 16px",
                  borderRadius:
                    "8px",
                  fontWeight:
                    700,
                  cursor:
                    saving ||
                    posting
                      ? "not-allowed"
                      : "pointer",
                  opacity:
                    saving ||
                    posting
                      ? 0.6
                      : 1,
                }}
              >
                {saving
                  ? "Saving..."
                  : "Save Changes"}
              </button>

              <button
                type="button"
                disabled={
                  saving ||
                  posting
                }
                onClick={() =>
                  saveInvoice(
                    true
                  )
                }
                style={{
                  border:
                    "none",
                  background:
                    "#16a34a",
                  color:
                    "#ffffff",
                  padding:
                    "9px 16px",
                  borderRadius:
                    "8px",
                  fontWeight:
                    700,
                  cursor:
                    saving ||
                    posting
                      ? "not-allowed"
                      : "pointer",
                  opacity:
                    saving ||
                    posting
                      ? 0.6
                      : 1,
                }}
              >
                {posting
                  ? "Saving & Posting..."
                  : "Save & Post"}
              </button>
            </div>
          </div>
        </div>
      )}
    </>
  );
}
